{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/api/ses/:adim",
      "destination": "/api/ses?adim=:adim"
    }
  ],
  "headers": [
    {
      "source": "/koken.jpg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "functions": {
    "api/hikaye.js": {
      "maxDuration": 60
    },
    "api/asistan.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/hikaye?adim=kuyruk",
      "schedule": "30 0 * * *"
    }
  ]
}
