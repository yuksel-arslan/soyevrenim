# KÖK — Ortam Değişkenleri (Vercel → Settings → Environment Variables)
# Bu dosya örnektir; gerçek değerleri Vercel paneline gir, buraya YAZMA.

# --- GİRİŞ (aile şifresi sistemi, Twilio YOK) ---
AILE_SIFRESI=aile-uyelerinin-ortak-sifresi
ADMIN_SIFRESI=senin-yonetici-sifren
OTURUM_GIZLI=en-az-40-karakter-rastgele-uzun-bir-metin-buraya

# --- VERİTABANI (Neon otomatik ekledi) ---
# DATABASE_URL=postgresql://...   ← Neon entegrasyonu otomatik ekler, elle girme

# --- FOTOĞRAF/VİDEO (Vercel Blob) ---
# BLOB_READ_WRITE_TOKEN=...       ← Vercel Blob storage oluşturunca otomatik eklenir

# --- ASİSTAN + SESLİ HİKÂYE (ücretsiz katman) — docs/asistan.md, docs/hikaye.md ---
# GROQ_API_KEY=...                 ← console.groq.com (Data Controls → Zero Data Retention AÇ)
# R2_ACCOUNT_ID=...                ← Cloudflare R2 (kova özel; CORS: PUT/GET/HEAD)
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_BUCKET=soyevrenim-ses
# CRON_SECRET=uzun-rastgele-metin  ← Vercel Cron (gece hikâye kuyruğu)
