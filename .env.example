# Bu dosya ÖRNEKTİR — gerçek değerleri Vercel panelinden gir, buraya YAZMA.
# (Bu dosya GitHub'a gidebilir; gerçek .env gitmez — .gitignore korur.)

# Neon PostgreSQL bağlantısı
DATABASE_URL=

# Yönetici (admin) kodu — index.html'dekiyle aynı olsun
ADMIN_CODE=

# Twilio (SMS ile giriş)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# BLOB_READ_WRITE_TOKEN — Vercel Blob deposu oluşturunca otomatik eklenir.
